#include <boards/arm/nice_nano/nice_nano_nrf52840.dts>
#include <dt-bindings/zmk/keys.h>

/ {
    kbd_matrix {
        compatible = "zmk,matrix-kbd";
        row-gpios = <&gpio0 17 GPIO_ACTIVE_HIGH>,
                    <&gpio0 18 GPIO_ACTIVE_HIGH>;
        col-gpios = <&gpio0 19 GPIO_ACTIVE_HIGH>,
                    <&gpio0 20 GPIO_ACTIVE_HIGH>;
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";
        default_layer {
            bindings = <
                KC_UP    KC_DOWN
                KC_LEFT  KC_RIGHT
            >;
        };
    };
};
